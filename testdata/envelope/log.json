{
  "header": {
    "dsn": "https://whatever@sentry.io/1337",
    "sdk": {
      "integrations": [
        "GlobalTags",
        "IgnoreErrors",
        "IgnoreTransactions"
      ],
      "name": "sentry.go",
      "packages": [
        {
          "name": "sentry-go"
        }
      ]
    }
  },
  "items": [
    {
      "header": {
        "content_type": "application/vnd.sentry.items.log+json",
        "item_count": 1,
        "type": "log"
      },
      "payload": {
        "items": [
          {
            "attributes": {
              "key": {
                "type": "string",
                "value": "value"
              },
              "sentry.environment": {
                "type": "string",
                "value": "test"
              },
              "sentry.message.parameters.0": {
                "type": "string",
                "value": "world"
              },
              "sentry.message.template": {
                "type": "string",
                "value": "hello %s"
              },
              "sentry.release": {
                "type": "string",
                "value": "app@1.0.0"
              },
              "sentry.sdk.name": {
                "type": "string",
                "value": "sentry.go"
              },
              "sentry.server.address": {
                "type": "string",
                "value": "golden"
              },
              "user.id": {
                "type": "string",
                "value": "42"
              }
            },
            "body": "hello world",
            "level": "info",
            "severity_number": 9
          }
        ]
      }
    }
  ]
}
